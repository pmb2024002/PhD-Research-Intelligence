@st.cache_data
def load_v2_data():
    import json
    if not V2_DATA_FILE.exists():
        return {}
    with open(V2_DATA_FILE, "r", encoding="utf-8") as f:
        records = json.load(f)
    return {
        str(r.get("paper_identity", {}).get("pmid", "")): r
        for r in records
    }


