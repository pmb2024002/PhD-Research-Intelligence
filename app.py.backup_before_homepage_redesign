            if st.button(
                "💾 Save Assessment",
                key=f"save_{pmid}",
            ):

                saved_label = (
                    ""
                    if selected_label == "Not labeled"
                    else selected_label
                )

                save_live_feedback(
                    pmid,
                    saved_label,
                    reason,
                )

                st.success(
                    "Assessment saved separately from the calibration dataset."
                )

                st.rerun()
